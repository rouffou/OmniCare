<Project>
  <ItemGroup>
    <!-- Médiateur CQRS (voir cahier_des_charges/architecture_technique_saas.md §1.2) -->
    <PackageVersion Include="Mediarq" Version="1.0.0" />
    <PackageVersion Include="Mediarq.Core" Version="1.0.0" />
    <PackageVersion Include="Mediarq.EntityFrameworkCore" Version="1.0.0" />
    <PackageVersion Include="Mediarq.Idempotency" Version="1.0.0" />

    <!-- Persistance -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <!-- Pin transitif : la 2.1.11 tirée par EF Core Sqlite a une vulnérabilité connue (NU1903) -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <!-- Outillage migrations (design-time uniquement) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />

    <!-- Validation -->
    <PackageVersion Include="FluentValidation" Version="11.11.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="11.11.0" />

    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
