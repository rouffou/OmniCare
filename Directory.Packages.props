<Project>
  <ItemGroup>
    <!-- Médiateur CQRS (voir cahier_des_charges/architecture_technique_saas.md §1.2) -->
    <PackageVersion Include="Mediarq" Version="1.5.1" />
    <PackageVersion Include="Mediarq.Core" Version="1.5.1" />
    <PackageVersion Include="Mediarq.EntityFrameworkCore" Version="1.5.1" />
    <PackageVersion Include="Mediarq.Idempotency" Version="1.5.1" />
    <PackageVersion Include="Mediarq.Outbox" Version="1.5.1" />
    <!-- Authentification : JWT Bearer OIDC générique (Authority/Audience configurables,
         ticket #26) — indépendant du fournisseur d'identité choisi. -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <!-- Persistance -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <!-- Pin transitif : la 2.1.11 tirée par EF Core Sqlite a une vulnérabilité connue (NU1903) -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.4" />
    <!-- Outillage migrations (design-time uniquement) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <!-- Validation -->
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />

    <!-- Documents PDF (facture patient, ticket #38) — édition Community, gratuite pour
         une structure sous 1M$ de revenu annuel ; à réévaluer si ce seuil est dépassé. -->
    <PackageVersion Include="QuestPDF" Version="2026.7.1" />

    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="xunit" Version="2.9.3" />
  </ItemGroup>
</Project>